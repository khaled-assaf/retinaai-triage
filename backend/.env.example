# Copy to backend/.env and edit. Real environment variables take precedence.
USE_MOCK_MODEL=true
CONFIDENCE_THRESHOLD=0.6
MAX_UPLOAD_MB=10
# Paths are relative to backend/ unless absolute.
STORAGE_DIR=storage_data
DB_PATH=storage_data/retinaai.db
MODEL_WEIGHTS_PATH=models/model.pth
# Fill an empty DB with ~8 demo cases on startup.
SEED_DEMO_CASES=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL used in shared European Retina Passport links / QR codes.
PUBLIC_BASE_URL=http://localhost:8000
SHARE_DAYS_VALID=30
